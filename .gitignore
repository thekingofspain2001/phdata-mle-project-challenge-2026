# Local env — never commit secrets or local overrides
.env

# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
test-results/

# Notebook outputs (regenerated on execute)
notebooks/imputation_comparison_results.csv

# IDE (share settings + recommended extensions, ignore machine-local state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/


# OS
.DS_Store
Thumbs.db

# Playwright CLI session snapshots (local verification artifacts)
.playwright-cli/
